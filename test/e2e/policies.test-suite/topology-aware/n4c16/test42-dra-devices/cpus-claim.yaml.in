apiVersion: resource.k8s.io/v1
kind: ResourceClaimTemplate
metadata:
  name: ${NAME}
spec:
  spec:
    devices:
      requests:
      - name: cpus
        exactly:
          deviceClassName: topology-aware.nri.io
          selectors:
          - cel:
              expression: device.attributes[\"resource.kubernetes.io\"].numaNode == ${NODE}
          capacity:
            requests:
              dra.cpu/cpu: '${CPUS}'

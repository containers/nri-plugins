apiVersion: resource.k8s.io/v1
kind: ResourceClaimTemplate
metadata:
  name: ${NAME}
spec:
  spec:
    devices:
      requests:
      - name: cpus
        exactly:
          deviceClassName: topology-aware.nri.io
          capacity:
            requests:
              dra.cpu/cpu: '${CPUS}'
      - name: memory
        exactly:
          deviceClassName: topology-aware.nri.io
          capacity:
            requests:
              memory: ${MEM}
      constraints:
      - matchAttribute: dra.cpu/socketID

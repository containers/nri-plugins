config:
  $([ -n "${AVAILABLE_CPU}" ] && echo "
  availableResources:
    cpu: ${AVAILABLE_CPU}")
  reservedResources:
    cpu: ${RESERVED_CPU:-750m}
  colocatePods: ${COLOCATE_PODS:-false}
  colocateNamespaces: ${COLOCATE_NAMESPACES:-false}
  pinCPU: ${PIN_CPU:-true}
  pinMemory: ${PIN_MEMORY:-true}
  $([ -n "${RESERVED_POOL_NAMESPACES}" ] && echo "
  reservedPoolNamespaces:$(for ns in ${RESERVED_POOL_NAMESPACES}; do echo "
    - $ns"; done)
  ")
  preferSharedCPUs: ${PREFER_SHARED_CPUS:-false}
  preferIsolatedCPUs: ${PREFER_ISOLATED_CPUS:-false}
  $([ -n "${UNLIMITED_BURSTABLE}" ] && echo "
  unlimitedBurstable: $UNLIMITED_BURSTABLE
  ")
  $([ -n "$SCHEDULING_CLASSES" ] && echo "
  schedulingClasses: $SCHEDULING_CLASSES
  ")
  $([ -n "$NAMESPACE_SCHEDULING_CLASSES" ] && echo "
  namespaceSchedulingClasses: $NAMESPACE_SCHEDULING_CLASSES
  ")
  $([ -n "$PODQOS_SCHEDULING_CLASSES" ] && echo "
  podQoSSchedulingClasses: $PODQOS_SCHEDULING_CLASSES
  ")
  $([ -n "$CPU_CLASSES" ] && echo "
  cpuClasses: $CPU_CLASSES
  ")
  $([ -n "$DEFAULT_EXCLUSIVE_CPUCLASS" ] && echo "
  defaultExclusiveCPUClass: $DEFAULT_EXCLUSIVE_CPUCLASS
  ")
  $([ -n "$SHARED_CPUCLASS" ] && echo "
  sharedCPUClass: $SHARED_CPUCLASS
  ")
  $([ -n "$RESERVED_CPUCLASS" ] && echo "
  reservedCPUClass: $RESERVED_CPUCLASS
  ")

  instrumentation:
    httpEndpoint: ":8891"
  log:
    debug:
      $(for logger in ${DEBUG_LOGGERS:-resource-manager cache libmem policy}; do echo "
      - $logger
      "; done )
    source: true
    klog:
      skip_headers: true

$([ -n "${!EXTRA_ENV_*}" ] && echo "
extraEnv:
  $(for var in ${!EXTRA_ENV_*}; do [[ "${!var}" != "" ]] && echo "
  ${var#EXTRA_ENV_}: '''${!var}'''
  "; done)
")

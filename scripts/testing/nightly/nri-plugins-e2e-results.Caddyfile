# Caddy configuration for serving the results of the e2e test runs, the ones
# e2e-runner publishes and e2e-report serves the reports of.
#
#   caddy run --config scripts/testing/nightly/nri-plugins-e2e-results.Caddyfile
#
# Caddy is the front end here and nothing else: it terminates the connection,
# compresses what goes out and passes everything on. Every page comes from
# e2e-report serve, which renders the index of the runs and the report of each
# run from what the runs recorded, reads into the tarball of a packed run, and
# serves a log as a page which follows it. None of that is a file on disk, so
# there is nothing here for a file server to serve.
#
#   install -m 644 scripts/testing/nightly/nri-plugins-e2e-results.service \
#       /etc/systemd/system/nri-plugins-e2e-results.service
#   systemctl daemon-reload && systemctl enable --now nri-plugins-e2e-results
#
# The port to listen on and the server to pass to can be given in the
# environment, which is all a test run of the whole thing needs:
#
#   E2E_PORT=8443 E2E_SERVER=127.0.0.1:8080 caddy run \
#       --config scripts/testing/nightly/nri-plugins-e2e-results.Caddyfile
#
# With a name which resolves from the outside, use that instead of the port
# and Caddy takes care of the certificates, too:
#
#   e2e.example.com {
#       ...
#   }

:{$E2E_PORT:8443} {
	# Where e2e-report serve listens, its --address, which is E2E_ADDRESS in
	# the unit. Keep that on the loopback interface: the restriction lives in
	# that address and nowhere else. A bare port here serves every interface,
	# on purpose, which is what a front end is for.
	reverse_proxy {$E2E_SERVER:127.0.0.1:8080}

	# The logs of a run are large and they are text.
	encode gzip zstd

	# Nothing sets Cache-Control here: the server answers every request with
	# no-cache itself. Results are worth caching, they just must not be reused
	# without asking, and no-store would re-download the logs.

	log {
		# Running as a service, swap this for a file of its own:
		#   output file /var/log/caddy/e2e-results.log
		output stderr
	}
}

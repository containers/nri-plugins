# Configuration for nri-plugins-e2e-results.service, to be installed as
# /etc/sysconfig/nri-plugins-e2e-results. Every setting left out here keeps the
# default the unit itself has, so uncomment only what this host changes.
#
# The address to listen on. Keep it on the loopback interface when caddy or
# another server sits in front of this one; a bare port serves every interface.
#E2E_ADDRESS=127.0.0.1:8080

# Where e2e-runner publishes to, its RESULT_ROOT.
#E2E_RESULTS=/opt/e2e-test/nri-plugins/results

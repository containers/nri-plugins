#!/bin/bash

set -o pipefail

#
# Default configuration, overridable on the command line.
#

# RESULT_ROOT:   directory for publishing results
# RESULT_NAME:   subdirectory for publishing results of this test run
# SKIP_WORKTREE: skip preparing worktree, assume it is already done
# E2E_TESTS:     e2e tests to run

# REMOTE_REPO: remote repository to clone
REMOTE_REPO="${REMOTE_REPO:-https://github.com/containers/nri-plugins}"
# CLONED_REPO: local location to clone to
CLONED_REPO="${CLONED_REPO:-/opt/e2e-test/nri-plugins/nri-plugins}"
# TEST_BRANCH: branch to clone and test
TEST_BRANCH="${TEST_BRANCH:-main}"
# RESULT_ROOT: directory for publishing each run's results under
RESULT_ROOT="${RESULT_ROOT:-/opt/e2e-test/nri-plugins/results}"
# RESULT_NAME: name of new test run
RESULT_NAME="${RESULT_NAME:-$(date +%Y-%m-%d-%H-%M)}"
# PROXIES_SRC: bash-sourcable file to set up proxies in the environment
PROXIES_SRC=""
# SKIP_WORKTREE: if set to non-empty, assume worktree already exists
SKIP_WORKTREE="${SKIP_WORKTREE:-}"
# E2E_TESTS: end-to-end tests to run instead of full test set
E2E_TESTS="${E2E_TESTS:-}"
# RETENTION_DAYS: remove published results older than this, 0 to keep them all
RETENTION_DAYS="${RETENTION_DAYS:-100}"
# RETENTION_KEEP: never remove this many latest results, however old they are
RETENTION_KEEP="${RETENTION_KEEP:-3}"
# KEEP_COVERAGE_DATA: keep the collected coverage data, not just the report
KEEP_COVERAGE_DATA="${KEEP_COVERAGE_DATA:-}"

# This script.
SELF="$0"
TEST_SUITE_DIR=policies.test-suite
GIT_SHA1="git.sha1"
GIT_DESC="git.describe"
# COVERAGE_REPORT_SH: script in test/e2e which reports on collected coverage
COVERAGE_REPORT_SH="report-coverage.sh"
# COVERAGE_REPORT_DIR: where that script puts the report, within a result dir
COVERAGE_REPORT_DIR="coverage-report"


#
# Derived configuration, set up after command line parsing
#
# RESULT_DIR: directory for publishing results of this test run
# WORKTREE:   git worktree for this test run
# LOG:        log file for this test run

RESULT_DIR=""
LOG=""
WORKTREE=""

usage() {
    local exit_code="${exit_code:-0}"

    echo "usage: ${1:-$SELF} [options] [<e2e-tests>]"
    echo
    echo "The possible options are:"
    echo "  --source-proxies <file>   source proxy environment variables from file"
    echo "  --remote|r <repo>         remote repository to clone/fetch from"
    echo "  --branch|-b <branch>      name of the remote branch to test"
    echo "  --local|-l <dir>          local directory to clone remote repository into"
    echo "  --results|--out|-o <dir>  top-level directory for publishing results"
    echo "  --name|-n <name>          subdirectory for results of this run"
    echo "  --skip-worktree           skip worktree preparation, assume already done"
    echo "  --retention-days <days>   remove results older than this, 0 to keep all"
    echo "                            (default: $RETENTION_DAYS)"
    echo "  --retention-keep <count>  always keep this many latest results"
    echo "                            (default: $RETENTION_KEEP)"
    echo "  --keep-coverage-data      keep collected coverage data, not just the report"
    echo "  --trace|-t|-x             run with set -x"
    echo "  --help                    show this help"

    exit $exit_code
}

info() {
    echo 1>&2 "$@"
}

error() {
    echo 1>&2 "error: $@"
}

fatal() {
    echo 1>&2 "fatal error: $@"
    exit 1
}

must-cd() {
    if ! cd "$1"; then
        fatal "failed to change directory to $1"
    fi
}

must-mkdir() {
    local dir="$1"; shift
    if ! mkdir -p "$dir"; then
        fatal "failed to create ${*:+$* }directory $dir"
    fi
}

must-mv() {
    if ! mv $*; then
        fatal "mv $* failed"
    fi
}

source_proxies() {
    local var

    if [ -z "$PROXIES_SRC" ]; then
        info "no proxies to set up..."
        return 0
    fi

    info "setting up proxies..."
    if ! source "$PROXIES_SRC"; then
        fatal "failed to source proxies from $src"
    fi

    for var in http_proxy https_proxy no_proxy HTTP_PROXY HTTPS_PROXY NO_PROXY; do
        if [ -n "${!var}" ]; then
            info "exporting proxy environment variable $var (with value ${!var})..."
            export $var
        fi
    done
}

prepare_worktree() {
    local worktree_dir="$(dirname $CLONED_REPO)/worktree"

    WORKTREE="$worktree_dir/$RESULT_NAME"
    case "$SKIP_WORKTREE" in
        1|true|yes|y)
            WORKTREE="$(realpath $WORKTREE)"
            must-cd "$WORKTREE"
            return 0
            ;;
    esac

    if [ ! -e "$CLONED_REPO" ]; then
        if ! git clone "$REMOTE_REPO" "$CLONED_REPO"; then
            fatal "failed to clone $REMOTE_REPO to $CLONED_REPO"
        fi
        must-cd "$CLONED_REPO"
    else
        must-cd "$CLONED_REPO"
        if ! git remote -v | grep origin | grep -q "$REMOTE_REPO"; then
            fatal "existing clone $CLONED_REPO has other origin than $REMOTE_REPO"
        fi
        if ! git fetch origin; then
            fatal "failed to fetch $REMOTE_REPO"
        fi
    fi

    WORKTREE="$(realpath $WORKTREE)"
    info "setting up git worktree $WORKTREE..."
    if ! git worktree add "$WORKTREE" "origin/$TEST_BRANCH"; then
        fatal "failed to add git worktree $WORKTREE"
    fi

    if [ -x "$WORKTREE/scripts/testing/e2e-runner" ]; then
        exec "$WORKTREE/scripts/testing/e2e-runner" \
             --skip-worktree \
             ${PROXIES_SRC:+--source-proxies }${PROXIES_SRC:-} \
             --remote "$REMOTE_REPO" \
             --branch "$TEST_BRANCH" \
             --local "$CLONED_REPO" \
             --results "$RESULT_ROOT" \
             --name "$RESULT_NAME" \
             "$E2E_TESTS"
    else
        must-cd "$WORKTREE"
    fi
}

prepare_result_dir() {
    # .txt, so that a browser shows the log instead of downloading it.
    local dir="$RESULT_DIR"
    local log="$dir/${SELF##*/}.log.txt"

    info "creating result dir $dir..."
    must-mkdir "$dir" "result"

    if ! touch "$log"; then
        fatal "failed to create log file $log"
    fi
    LOG="$log"

    info "Redirecting output to log file $LOG..."
    if ! exec &>"$LOG"; then
        fatal "log redirection failed"
    fi
}

run_e2e_tests() {
    local k8scri=containerd

    # test every other day with cri-o
    if [ $(( $(date +%j) % 2 )) != 0 ]; then
        k8scri=crio
    fi

    # once per week build all binaries and images, otherwise just the bare minimal set
    if [ $(( $(date +%j) % 7 )) != 0 ]; then
       export PLUGINS="nri-resource-policy-balloons nri-resource-policy-topology-aware"
       export BINARIES=""
       export OTHER_IMAGE_TARGETS=""
    fi

    info "running e2e tests ${E2E_TESTS:-with the default test set}..."
    must-cd "$WORKTREE"
    if [ -n "$E2E_TESTS" ]; then
        make SKIP_LICENSES=1 k8scri=$k8scri E2E_TESTS="$E2E_TESTS" e2e-tests
    else
        make SKIP_LICENSES=1 k8scri=$k8scri e2e-tests
    fi
}

cleanup_test_vms() {
    local src

    info "cleaning up test VMs..."
    must-cd "$WORKTREE"
    for src in e2e-results/*; do
        (cd "$src" && vagrant destroy --force)
    done
}

collect_git_info() {
    local describe="$RESULT_DIR/$GIT_DESC"
    local sha1="$RESULT_DIR/$GIT_SHA1"

    info "collecting info about worktree..."
    must-cd "$WORKTREE"
    git describe > "$describe"
    git log -1 --pretty=%H > "$sha1"
}

collect_results() {
    local src dst

    info "collecting test results..."
    must-cd "$WORKTREE"
    # Only the results of a VM are ours to collect. The tests leave other
    # things next to them, the merged coverage report for one, which we
    # regenerate from the collected data anyway.
    for src in e2e-results/*; do
        if [ ! -d "$src/$TEST_SUITE_DIR" ]; then
            info "skipping $src, it has no $TEST_SUITE_DIR..."
            continue
        fi
        dst=$RESULT_DIR/${src#e2e-results/}
        must-mkdir "$dst" "result"
        must-mv "$src/$TEST_SUITE_DIR" "$dst"
    done
}

generate_coverage_report() {
    local report="$WORKTREE/test/e2e/$COVERAGE_REPORT_SH"

    if [ ! -x "$report" ]; then
        info "no $report, skipping the coverage report..."
        return 0
    fi

    info "generating coverage report for $RESULT_DIR..."
    must-cd "$WORKTREE"
    if ! "$report" "$RESULT_DIR"; then
        error "failed to generate coverage report for $RESULT_DIR"
    fi
}

cleanup_worktree() {
    info "cleaning up worktree $WORKTREE..."
    must-cd "$CLONED_REPO"
    if ! git worktree remove --force "$WORKTREE"; then
        fatal "failed to remove worktree $WORKTREE..."
    fi
}

generate_summary() {
    local summary="$RESULT_DIR/summary.txt"
    local suite vm dir f test result

    info "generating summary $summary..."
    rm -f "$summary"
    if ! touch "$summary"; then
        error "failed to create $summary"
        return
    fi

    # Every collected VM, whatever its topology is called. Matching the names
    # of the topologies we happen to have would silently leave the results of
    # a new one out of the summary, and out of the verdict of the whole run.
    for suite in $RESULT_DIR/*/$TEST_SUITE_DIR; do
        if [ ! -d "$suite" ]; then
            continue
        fi
        vm="${suite%/$TEST_SUITE_DIR}"
        echo "${vm##*/}:" >> "$summary"
        for dir in $(find $suite -name 'test[0-9]*-*' -type d); do
            # Serve logs as text, otherwise a browser downloads them instead
            # of showing them.
            for f in $dir/*.output $dir/*.log; do
                if [ -f "$f" ]; then
                    must-mv "$f" "$f.txt"
                fi
            done
            test="${dir##*$TEST_SUITE_DIR/}"
            result="- FAIL"
            if [ -f "$dir/summary.txt" ] && grep -q PASS "$dir/summary.txt"; then
                result="+ PASS"
            fi
            echo "  $result $test"
        done | sort >> "$summary"
    done
}

generate_index() {
    local index="$RESULT_ROOT/index.html"
    local run status sha1 desc

    info "updating index $index..."
    rm -f "$index"
    if ! touch "$index"; then
        error "failed to create $index"
        return 1
    fi

    >>$index cat <<EOF
    <html>
      <head><title>NRI Reference Plugins Test Results</title></head>
      <body>
EOF

    echo "      <ul>" >> "$index"
    for run in $(ls -1 $RESULT_ROOT --sort=time); do
        case $run in
            [0-9][0-9][0-9][0-9]-*) ;;
             *) continue
                ;;
        esac
        if [ ! -e "$RESULT_ROOT/$run/summary.txt" ] || grep -q FAIL "$RESULT_ROOT/$run/summary.txt"; then
            status="FAIL"
        else
            status="PASS"
        fi
        sha1=$(get_test_entry $run $GIT_SHA1 unknown-sha1)
        desc=$(get_test_entry $run $GIT_DESC unknown-git-version)
        echo "        <li>$status <a href=\"$run\">$run (version $desc, $sha1) </a></li>" >> "$index"
    done
    echo "      </ul>" >> "$index"

    >>"$index" cat <<EOF
      </body>
    </html>
EOF
}

prune_coverage_data() {
    local profile="$RESULT_DIR/$COVERAGE_REPORT_DIR/coverprofile"

    case "$KEEP_COVERAGE_DATA" in
        1|true|yes)
            info "keeping the coverage data collected for the tests..."
            return 0
            ;;
    esac

    # Without a profile there is nothing to fall back on, so keep the data
    # whatever we were told: it is the only coverage we have of this run.
    if [ ! -f "$profile" ]; then
        info "no coverage profile in $RESULT_DIR, keeping the collected data..."
        return 0
    fi

    info "removing the coverage data collected for the tests..."
    # Keep the report, which includes the data merged over the run, so
    # that everything but the per test numbers can still be regenerated
    # from what we publish. Only ever remove data files, then only prune
    # directories which removing those leaves empty.
    find "$RESULT_DIR" -type f \
         \( -name 'covmeta.*' -o -name 'covcounters.*' \) \
         -not -path "$RESULT_DIR/$COVERAGE_REPORT_DIR/*" -delete
    find "$RESULT_DIR" -type d -name coverage -empty -delete
}

prune_old_results() {
    local run stamp when age kept=0

    case "$RETENTION_DAYS" in
        ""|0|no|none|forever)
            info "keeping all published results..."
            return 0
            ;;
    esac

    info "removing published results older than $RETENTION_DAYS days..."
    for run in $(ls -1 "$RESULT_ROOT" --sort=time 2>/dev/null); do
        case $run in
            [0-9][0-9][0-9][0-9]-*) ;;
            *) continue
               ;;
        esac

        # Keep the latest results regardless of their age, so that a break in
        # running the tests cannot leave us without any results at all.
        kept=$((kept + 1))
        if [ "$kept" -le "$RETENTION_KEEP" ]; then
            continue
        fi

        # The name of a run is when it started. Fall back to the timestamp of
        # the directory for a name we don't recognize.
        stamp="${run:0:10}"
        if ! when=$(date -d "$stamp" +%s 2>/dev/null); then
            when=$(stat -c %Y "$RESULT_ROOT/$run" 2>/dev/null)
        fi
        if [ -z "$when" ]; then
            error "failed to tell how old $run is, keeping it"
            continue
        fi

        age=$(( ($(date +%s) - when) / (24 * 3600) ))
        if [ "$age" -le "$RETENTION_DAYS" ]; then
            continue
        fi

        info "removing $run, $age days old..."
        if ! rm -rf "$RESULT_ROOT/$run"; then
            error "failed to remove $RESULT_ROOT/$run"
        fi
    done
}

get_test_entry() {
    local run="$1" entry="$2" default="${3:-unknown}"
    local file="$RESULT_ROOT/$run/$entry" buf

    if [ ! -e "$file" ]; then
        echo "$default"
        return 0
    fi
    if ! buf="$(cat $file)"; then
        echo "$default"
        return 0
    fi

    echo "$buf"
    return 0
}

#
# main script
#

HANDOVER_ARGS=""

while [  "$#" -gt 0 ] && [ "${1#-}" != "$1" ]; do
    case $1 in
        --source-proxies)
            PROXIES_SRC="$2"
            shift 2
            ;;
        --remote|-r)
            REMOTE_REPO="$2"
            shift 2
            ;;
        --branch|-b)
            TEST_BRANCH="$2"
            shift 2
            ;;
        --local|-l)
            CLONED_REPO="$2"
            shift 2
            ;;
        --results|--out|-o)
            RESULT_ROOT="$2"
            shift 2
            ;;
        --name|-n)
            RESULT_NAME="$2"
            shift 2
            ;;
        --skip-worktree)
            SKIP_WORKTREE=1
            shift
            ;;
        --retention-days)
            RETENTION_DAYS="$2"
            shift 2
            ;;
        --retention-keep)
            RETENTION_KEEP="$2"
            shift 2
            ;;
        --keep-coverage-data)
            KEEP_COVERAGE_DATA=1
            shift
            ;;

        --trace|-t|-x)
            set -x
            shift
            ;;
        --help|-h)
            usage $0
            ;;

        *)
            fatal "unknown command line option $1"
            ;;
        esac
done

E2E_TESTS="$*"
RESULT_DIR="$RESULT_ROOT/$RESULT_NAME"

source_proxies
prepare_worktree
prepare_result_dir
run_e2e_tests
cleanup_test_vms
collect_git_info
collect_results
generate_coverage_report
cleanup_worktree
generate_summary
prune_coverage_data
prune_old_results
generate_index


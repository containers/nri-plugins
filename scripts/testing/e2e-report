def report_run(result_dir):
    """Write results.json and index.html for one run."""
    if not os.path.isdir(result_dir):
        sys.exit("e2e-report: no such directory: %s" % result_dir)

    run = scan_run(result_dir)

    with open(os.path.join(result_dir, RESULTS_JSON), "w",
              encoding="utf-8") as f:
        json.dump(run, f, indent=2, sort_keys=True)
        f.write("\n")

    with open(os.path.join(result_dir, INDEX_HTML), "w",
              encoding="utf-8") as f:
        f.write(render_run(run))

    counts = run["counts"]
    status = "%s %d/%d tests passed\n" % (
        run["verdict"], counts.get("PASS", 0), counts.get("total", 0))

    # One line for whoever runs the tests to act on without reading json.
    with open(os.path.join(result_dir, STATUS_TXT), "w", encoding="utf-8") as f:
        f.write(status)

    print("%s: %s" % (run["name"], status.strip()))


def is_run(dir):
    """Tell whether a directory holds the results of a run.

    Going by what is in it rather than by what it is called: --name takes
    anything. A run which was cut short before it collected a single result
    still has the log of the runner, and belongs in the index just as much.
    """
    if os.path.islink(dir) or not os.path.isdir(dir):
        return False
    return any(os.path.exists(os.path.join(dir, f))
               for f in (RESULTS_JSON, "summary.txt", RUNNER_LOG))


def report_index(root):
    """Rebuild the index of every run under root."""
    if not os.path.isdir(root):
        sys.exit("e2e-report: no such directory: %s" % root)

    runs = []
    for name in sorted(os.listdir(root)):
        dir = os.path.join(root, name)
        if not is_run(dir):
            continue

        results = os.path.join(dir, RESULTS_JSON)
        # A run from before we reported on runs at all, or one which was cut
        # short: give it a report of its own, so that the index has somewhere
        # to link to.
        if not os.path.exists(results) or not os.path.exists(
                os.path.join(dir, INDEX_HTML)):
            report_run(dir)

        try:
            with open(results, encoding="utf-8") as f:
                run = json.load(f)
            # An older version of us did not tell when a run ran, and we order
            # them by that, so fill it in for those.
            if not run.get("started"):
                run["started"] = started_at(run.get("name") or name, dir)
            runs.append(run)
        except (OSError, ValueError):
            runs.append(scan_run(dir))

    # Latest first, by when they ran rather than by what they are called.
    runs.sort(key=lambda run: run.get("started") or "", reverse=True)

    with open(os.path.join(root, INDEX_HTML), "w", encoding="utf-8") as f:
        f.write(render_index(runs))

    print("indexed %d test runs in %s" % (len(runs), root))


def main():
    if len(sys.argv) != 3 or sys.argv[1] not in ("run", "index"):
        sys.exit(__doc__.strip())

    if sys.argv[1] == "run":
        report_run(sys.argv[2])
    else:
        report_index(sys.argv[2])


if __name__ == "__main__":
    main()

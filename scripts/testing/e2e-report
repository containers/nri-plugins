def e(text):
    return html.escape(str(text if text is not None else ""))


def link(href, text):
    return '<a href="%s">%s</a>' % (e(href), e(text))


def verdict_html(verdict):
    return '<span class="verdict %s">%s</span>' % (e(verdict), e(verdict))


def duration_html(seconds):
    if seconds is None:
        return ""
    if seconds < 60:
        return "%.0fs" % seconds
    return "%dm%02ds" % (int(seconds) // 60, int(seconds) % 60)


def links_html(links):
    order = [label for label, _ in ARTIFACTS] + ["runtime log", "source"]
    ordered = sorted(links.items(), key=lambda kv: (
        order.index(kv[0]) if kv[0] in order else len(order), kv[0]))
    return '<span class="links">%s</span>' % "".join(
        link(href, label) for label, href in ordered)


def plugin_link(run, policy, plugin):
    """Link a policy to the source of its plugin, at the tested revision.

    The name of the plugin comes from the paths in the coverage data, so
    cmd/plugins/<plugin> is a directory which exists in that revision.
    """
    web, sha1 = run["git"]["web"], run["git"]["sha1"]
    if not web or not sha1:
        return e(policy)
    return link("%s/tree/%s/cmd/plugins/%s" % (web, sha1, plugin or policy),
                policy)


def source_link(run, test):
    """Link a test case to its source, at the revision which was tested."""
    web, sha1 = run["git"]["web"], run["git"]["sha1"]
    if not web or not sha1 or not test["topology"]:
        return {}
    return {"source": "%s/blob/%s/test/e2e/%s/%s/%s/%s/code.var.sh" % (
        web, sha1, TEST_SUITE_DIR, test["policy"], test["topology"],
        test["name"])}


def page(title, body):
    return ("<!DOCTYPE html>\n<html>\n<head>\n"
            "<meta charset=\"utf-8\">\n"
            "<title>%s</title>\n<style>%s</style>\n</head>\n<body>\n%s"
            "</body>\n</html>\n" % (e(title), CSS, body))


def render_coverage(run):
    """A table of the coverage of each plugin, and of everything."""
    coverage = run["coverage"]
    rows = []

    for policy, data in sorted(coverage["policies"].items()):
        rows.append(
            "<tr><td>%s</td><td class=\"num\">%d</td>"
            "<td class=\"num\">%s</td><td class=\"num\">%s</td><td>%s</td></tr>" % (
                plugin_link(run, policy, data.get("plugin")),
                data.get("tests", 0),
                "%.1f%%" % data["plugin_percent"]
                if data.get("plugin_percent") is not None else "",
                "%.1f%% (%d/%d)" % (data["percent"], data["covered"],
                                    data["statements"]),
                links_html(data.get("links", {}))))

    if coverage["all"]:
        data = coverage["all"]
        rows.append(
            "<tr><td><em>all tests</em></td><td class=\"num\">%d</td>"
            "<td class=\"num\"></td><td class=\"num\">%s</td><td>%s</td></tr>" % (
                data.get("tests", 0),
                "%.1f%% (%d/%d)" % (data["percent"], data["covered"],
                                    data["statements"]),
                links_html(data.get("links", {}))))

    if not rows:
        return ("<h2>Coverage</h2>\n<p>No coverage data was collected. Were the"
                " plugins built with instrumentation (make COVER=1)?</p>\n")

    return ("<h2>Coverage</h2>\n<table>\n<tr><th>policy</th>"
            "<th class=\"num\">tests</th>"
            "<th class=\"num\">plugin logic</th>"
            "<th class=\"num\">all instrumented packages</th>"
            "<th></th></tr>\n%s\n</table>\n" % "\n".join(rows))


def render_failures(run):
    """The failures of a run, with the reason and the artifacts of each."""
    failed = [t for t in run["tests"] if t["verdict"] not in ("PASS", "SKIP")]
    if not failed:
        return ""

    rows = []
    for test in failed:
        links = dict(test["links"])
        links.update(source_link(run, test))
        reason = ('<pre class="reason">%s</pre>' % e(test["reason"])
                  if test["reason"] else "")
        rows.append(
            "<tr><td>%s</td><td>%s / %s / %s</td><td class=\"num\">%s</td>"
            "<td>%s%s</td></tr>" % (
                verdict_html(test["verdict"]), e(test["policy"]),
                e(test["topology"] or test["vm"]), e(test["name"]),
                duration_html(test["duration"]), links_html(links), reason))

    return ("<h2>Failures (%d)</h2>\n<table>\n%s\n</table>\n"
            % (len(failed), "\n".join(rows)))


def render_tests(run):
    """Every test case, in a section per VM which the reader can fold away."""
    if not run["tests"]:
        return ""

    sections = []
    for vm in sorted({t["vm"] for t in run["tests"]}):
        of_vm = [t for t in run["tests"] if t["vm"] == vm]
        passed = len([t for t in of_vm if t["verdict"] == "PASS"])

        rows = []
        for test in of_vm:
            links = dict(test["links"])
            links.update(source_link(run, test))
            rows.append(
                "<tr><td>%s</td><td>%s / %s</td><td class=\"num\">%s</td>"
                "<td>%s</td></tr>" % (
                    verdict_html(test["verdict"]), e(test["policy"]),
                    e(test["name"]), duration_html(test["duration"]),
                    links_html(links)))

        # Fold away what went through, leave open what did not.
        sections.append(
            "<details%s>\n<summary>%s <span class=\"counts\">&mdash; %d/%d"
            " passed</span></summary>\n<table>\n<tr><th>verdict</th>"
            "<th>test</th><th class=\"num\">duration</th>"
            "<th></th></tr>\n%s\n</table>\n"
            "</details>\n" % (
                "" if passed == len(of_vm) else " open", e(vm), passed,
                len(of_vm), "\n".join(rows)))

    return ("<h2>Test cases (%d)</h2>\n%s" % (len(run["tests"]),
                                              "".join(sections)))


def render_run(run):
    """The report of a single run."""
    counts = run["counts"]
    title = "e2e results %s: %s" % (run["name"], run["verdict"])

    meta = []
    if run["git"]["describe"]:
        version = e(run["git"]["describe"])
        if run["git"]["web"] and run["git"]["sha1"]:
            version = link("%s/commit/%s" % (run["git"]["web"],
                                            run["git"]["sha1"]),
                           run["git"]["describe"])
        meta.append(version)
    if run["runtimes"]:
        meta.append(e(", ".join(run["runtimes"])))
    if run["started"]:
        meta.append("started %s" % e(run["started"].replace("T", " ")))
    if run["log"]:
        meta.append(link(run["log"], "runner log"))
    meta.append(link("..", "all runs"))

    body = ["<h1>e2e results %s &mdash; %s</h1>\n" % (
        e(run["name"]), verdict_html(run["verdict"]))]
    body.append('<div class="meta">%s</div>\n' % " &middot; ".join(meta))
    body.append('<p class="counts">%d test cases: %d passed, %d failed,'
                " %d errored, %d skipped.</p>\n" % (
                    counts.get("total", 0), counts.get("PASS", 0),
                    counts.get("FAIL", 0), counts.get("ERROR", 0),
                    counts.get("SKIP", 0)))

    if not run["tests"]:
        body.append("<p>No test results were collected for this run. See the"
                    " runner log for what happened.</p>\n")

    body.append(render_failures(run))
    body.append(render_coverage(run))
    body.append(render_tests(run))

    return page(title, "".join(body))


def render_index(runs):
    """The list of runs, latest first."""
    plugins = sorted({p for run in runs for p in run["coverage"]["policies"]})

    header = ["<th>run</th>", "<th>verdict</th>",
              '<th class="num">tests</th>']
    header += ['<th class="num">%s</th>' % e(p) for p in plugins]
    header += ["<th>runtime</th>", "<th>version</th>"]

    rows = []
    for run in runs:
        counts = run["counts"]
        cells = [
            "<td>%s</td>" % link("%s/%s" % (run["name"], INDEX_HTML),
                                 run["name"]),
            "<td>%s</td>" % verdict_html(run["verdict"]),
            "<td class=\"num\">%d/%d</td>" % (counts.get("PASS", 0),
                                              counts.get("total", 0)),
        ]
        for plugin in plugins:
            data = run["coverage"]["policies"].get(plugin)
            percent = data.get("plugin_percent") if data else None
            cells.append("<td class=\"num\">%s</td>"
                         % ("%.1f%%" % percent if percent is not None else ""))
        cells.append("<td>%s</td>" % e(", ".join(run["runtimes"])))
        version = e(run["git"]["describe"])
        if run["git"]["web"] and run["git"]["sha1"]:
            version = link("%s/commit/%s" % (run["git"]["web"],
                                             run["git"]["sha1"]),
                           run["git"]["describe"])
        cells.append("<td>%s</td>" % version)
        rows.append("<tr>%s</tr>" % "".join(cells))

    body = ["<h1>NRI reference plugins e2e test results</h1>\n"]
    if rows:
        body.append("<table>\n<tr>%s</tr>\n%s\n</table>\n"
                    % ("".join(header), "\n".join(rows)))
    else:
        body.append("<p>No test runs have been published yet.</p>\n")

    return page("NRI reference plugins e2e test results", "".join(body))



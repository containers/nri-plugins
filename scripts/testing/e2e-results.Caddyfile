# Caddy configuration for serving the results of the e2e test runs, the ones
# e2e-runner publishes and e2e-report generates the reports of.
#
#   caddy run --config scripts/testing/e2e-results.Caddyfile
#
# The results to serve and the port to serve them on can be given in the
# environment, which is all a test run of the whole thing needs:
#
#   E2E_RESULTS=$HOME/e2e-results E2E_PORT=8080 \
#       caddy run --config scripts/testing/e2e-results.Caddyfile
#
# With a name which resolves from the outside, use that instead of the port
# and Caddy takes care of the certificates, too:
#
#   e2e.example.com {
#       ...
#   }

:{$E2E_PORT:8080} {
	# Where e2e-runner publishes to, its RESULT_ROOT.
	root * {$E2E_RESULTS:/opt/e2e-test/nri-plugins/results}

	# index.html of the root lists the runs, each run has one of its own,
	# and browsing covers the directories which have none: the commands a
	# test case ran, for instance.
	file_server browse

	# The logs of a run are large and they are text.
	encode gzip zstd

	# Should we ever publish the logs pre-compressed, this serves foo.txt
	# from a foo.txt.gz, so that the links of the reports keep working:
	#file_server {
	#	precompressed gzip
	#}

	log {
		# Running as a service, swap this for a file of its own:
		#   output file /var/log/caddy/e2e-results.log
		output stderr
	}
}
